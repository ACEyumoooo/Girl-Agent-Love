## Help screen #################################################################
##
## A screen that gives information about key and mouse bindings. It uses
## other screens (keyboard_help, mouse_help, and gamepad_help) to display the
## actual help.

screen help():

    tag menu

    default device = "keyboard"

    use game_menu(_("Help"), scroll="viewport"):

        style_prefix "help"

        vbox:
            spacing gui.scale(15)

            hbox:

                textbutton _("Keyboard") action SetScreenVariable("device", "keyboard")
                textbutton _("Mouse") action SetScreenVariable("device", "mouse")

                if GamepadExists():
                    textbutton _("Gamepad") action SetScreenVariable("device", "gamepad")

            if device == "keyboard":
                use keyboard_help
            elif device == "mouse":
                use mouse_help
            elif device == "gamepad":
                use gamepad_help


screen keyboard_help():

    ## 按当前设置里的实际键位显示，改了快捷键这里也跟着变
    vbox:
        spacing gui.scale(6)
        for _hk, _hlabel in SETTINGS_KEYS:
            $ _hcombo = settings_value(_hk, "")
            if _hcombo:
                hbox:
                    label _hcombo
                    text _hlabel

        hbox:
            label _("Escape")
            text _("关闭当前界面")

        hbox:
            label _("滚轮")
            text _("历史记录里上下翻动")

        text _("注意：本作关闭了剧情回滚，PageUp / PageDown 只在历史记录里翻页；Ctrl 快进为按住生效。") size 13 color "#9a8f7d"


