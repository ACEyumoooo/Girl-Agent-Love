## Navigation screen ###########################################################
##
## This screen is included in the main and game menus, and provides navigation
## to other menus, and to start the game.

screen nav_item(label, action, sensitive=True):
    vbox:
        spacing 0
        textbutton label:
            action action
            sensitive sensitive
            style ("title_navigation_button" if main_menu else "navigation_button")
            text_style ("title_navigation_button_text" if main_menu else "navigation_button_text")
            at (nav_hover if main_menu else gal_ui_still)

screen navigation():
    predict False

    vbox:
        style_prefix "navigation"

        xpos (gui.navigation_xpos if main_menu else 40)
        yalign 0.5

        spacing (gui.navigation_spacing if main_menu else 8)

        if main_menu:

            $ _quick_exists = os.path.exists(slot_path("quick"))
            use nav_item(_("Start"), Show("start_choice"))

            use nav_item(_("继续游戏"), Function(load_and_jump, "quick"), _quick_exists)

        else:

            use nav_item(_("History"), ShowMenu("history"))

            use nav_item(_("Save"), [Function(capture_pending_thumb), Show("ai_slots", mode="save")])

        use nav_item(_("Load"), Show("ai_slots", mode="load"))

        use nav_item(_("设置"), Function(settings_open))

        if not AI_KEY and not harness_available():

            text _("未配置 Key，当前为离线演示") size 14 color ("#f2ead9" if main_menu else gal_ui_muted)

        if _in_replay:

            textbutton _("End Replay") action EndReplay(confirm=True)

        elif not main_menu:

            use nav_item(_("Main Menu"), MainMenu())

        use nav_item(_("About"), ShowMenu("about"))

        if not main_menu and (renpy.variant("pc") or (renpy.variant("web") and not renpy.variant("mobile"))):

            ## Help isn't necessary or relevant to mobile devices.
            use nav_item(_("Help"), ShowMenu("help"))

        if renpy.variant("pc"):

            ## The quit button is banned on iOS and unnecessary on Android and Web.
            use nav_item(_("Quit"), Quit(confirm=not main_menu))



