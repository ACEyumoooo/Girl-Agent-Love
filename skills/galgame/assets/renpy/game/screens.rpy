## Say screen ##################################################################
##
## The say screen is used to display dialogue to the player. It takes two
## parameters, who and what, which are the name of the speaking character and
## the text to be displayed, respectively. (The who parameter can be None
## if no name is given.)
##
## This screen must create a text displayable with id "what", as Ren'Py
## uses this to manage text display. It can also create displayables with
## id "who" and id "window" to apply style properties.
##
## https://www.renpy.org/doc/html/screen_special.html#say

screen say(who, what):

    $ _line_is_read = getattr(renpy.store, "_cur_line_seen", False)
    $ _line_color = text_read_color() if _line_is_read else text_unread_color()

    ## 自动跳过已读文本：自动模式下，已读句不等待直接推进
    if _line_is_read and preferences.afm_enable and settings_value("GALGAME_SKIP_READ", "0") in ("1", "true", "yes", "on"):
        timer 0.2 action Return()

    window:
        id "window"
        background textbox_background(config.screen_width, gui.textbox_height, color=(settings_value("GALGAME_VIEWPOINT_COLOR", "#f5dfb6") if who is not None and getattr(renpy.store, "gal_viewpoint_changed", False) else settings_value("GALGAME_TEXTBOX_COLOR", "#fffcf6")))

        if who is not None:

            window:
                id "namebox"
                style "namebox"
                text who id "who"

        text what id "what" color _line_color


    ## If there's a side image, display it above the text. Do not display
    ## on the phone variant - there's no room.
    if not renpy.variant("small"):
        add SideImage() xalign 0.0 yalign 1.0


